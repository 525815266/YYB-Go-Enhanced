# ==========================================
# YYB Go 环境变量配置文件示例
# ==========================================

# Web 用户认证。默认 SQLite 文件位于持久化目录 resource/db/auth.db。
# 不填写初始化管理员时，第一个注册账号自动成为管理员。
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=
YYB_ADMIN_USER=
YYB_ADMIN_PASSWORD=
# 已有 MySQL 部署可继续只设置此旧变量，程序会自动选择 mysql。
# YYB_AUTH_MYSQL_DSN=yyb_go:replace-db-password@tcp(mysql:3306)/yyb_go?charset=utf8mb4&parseTime=true&loc=UTC
# 使用 HTTPS 反代时改为 true
YYB_COOKIE_SECURE=false
# 桌面微信快速授权目前不稳定，默认关闭；仅在已验证本机微信环境后显式开启。
YYB_ENABLE_PC_LOGIN=false

# 服务绑定地址与端口
YYB_BIND_ADDRESS=0.0.0.0
YYB_PORT=8000

# 账号保活检查间隔与提前刷新时间
YYB_KEEPALIVE_INTERVAL=1m
YYB_KEEPALIVE_AHEAD=45m

# 账号独立代理请在 Web 控制台中设置并保存到协议 SQLite。
# 代理账号默认仅在凭据到期前 5 分钟刷新，可在账号代理页单独调整。
# Magisk TCP_PROXY / 命令行 -tcp-proxy 只作为未配置账号的兼容默认值。

# ------------------------------------------
# 面板类型配置 (PANEL_TYPE)
# 可选值: qinglong (默认青龙面板)、daidai (呆呆面板) 或 arcadia
# 当指定 PANEL_TYPE=daidai 时，系统会自动切换至呆呆面板适配模式并使用对应的默认 URL(http://daidai-panel:5700)
# ------------------------------------------
PANEL_TYPE=qinglong

# 青龙面板配置 (当 PANEL_TYPE=qinglong 时生效)
# QL_URL 默认为 http://qinglong:5700
QL_URL=http://qinglong:5700
QL_CLIENT_ID=
QL_CLIENT_SECRET=

# 呆呆面板配置 (当 PANEL_TYPE=daidai 时可单独指定，不填则自动使用默认 http://daidai-panel:5700)
# DAIDAI_URL=http://daidai-panel:5700
# DAIDAI_APP_KEY=
# DAIDAI_APP_SECRET=

# Arcadia 配置 (当 PANEL_TYPE=arcadia 时生效)
# Token 需要 env:query、env:manage、cron:query、cron:manage、cron:run、file:list、file:read 权限
# ARCADIA_URL=http://arcadia:5678
# ARCADIA_TOKEN=

# YYB 回调地址 (供自动化面板中的脚本回调使用)
YYB_QINGLONG_SERVER=yyb-go:8000

# 同步的脚本仓库列表 (多个库用逗号分隔)
YYB_QINGLONG_REPO=SuperNaiBA_YYB-GO-Script,525815266_YYB-Go-Enhanced/scripts
