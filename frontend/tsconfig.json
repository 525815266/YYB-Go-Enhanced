{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@vben-core/layout-ui": ["./vendor/layout/src/index.ts"],
      "@vben-core/menu-ui": ["./vendor/menu/src/index.ts"],
      "@vben-core/shadcn-ui": ["./vendor/shadcn/src/index.ts"],
      "@vben-core/composables": ["./vendor/composables/src/index.ts"],
      "@vben-core/typings": ["./vendor/typings/src/index.ts"],
      "@vben-core/icons": ["./vendor/icons/src/index.ts"],
      "@vben-core/shared/*": [
        "./vendor/shared/src/*/index.ts",
        "./vendor/shared/src/*.ts"
      ],
      "@vben-core/design": ["./vendor/design/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "vben-aliases.ts"
  ]
}
